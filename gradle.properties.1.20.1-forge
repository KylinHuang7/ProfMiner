# ============================================
# 此文件为 1.20.1 Forge 分支的 gradle.properties 示例
# 切换到 1.20.1 分支时，用此文件替换根目录的 gradle.properties
# ============================================

# Gradle 配置
org.gradle.jvmargs=-Xmx4G
org.gradle.daemon=true
org.gradle.parallel=true

# Architectury (1.20.1 对应 Architectury 9.x)
architectury_version=9.2.14

# Minecraft
minecraft_version=1.20.1

# Forge
forge_version=47.2.0
forge_version_range=[47,)
forge_loader_version_range=[47,)

# NeoForge (1.20.1 没有独立的 NeoForge，注释掉)
# neoforge_version=

# Mod 属性
mod_id=profminer
mod_name=Professional Miner
mod_version=1.0.1
mod_group_id=com.kylinhome.minecraft.profminer
mod_authors=KylinHuang
mod_description=A professional mining mod that adds new ores, materials and equipment.
mod_license=All Rights Reserved

# 版本范围 (Forge 1.20.1)
minecraft_version_range=[1.20.1,1.21)
